# ─────────────────────────────────────────────────────────────
# WYLDE — Configuration d'environnement
# Copier ce fichier en .env puis adapter les valeurs.
# .env n'est JAMAIS versionné (voir .gitignore).
#
# Les valeurs ci-dessous sont volontairement prudentes pour un serveur :
# en production, ne JAMAIS laisser APP_DEBUG=true ni SESSION_SECURE=false.
# Pour du développement local, il faut inverser ces quatre lignes.
# ─────────────────────────────────────────────────────────────

# Environnement : local | production
APP_ENV=production
APP_DEBUG=false
APP_URL=https://exemple.com
APP_NAME="WYLDE"
APP_TIMEZONE=Africa/Dakar

# Génération des liens à partir de la requête courante plutôt que de
# APP_URL : à activer derrière un reverse proxy ou quand le DocumentRoot
# pointe directement sur public/ (l'hôte n'est alors plus connu d'avance).
# Laisser false si APP_URL est toujours correct.
APP_URL_FROM_REQUEST=false
# Hôtes acceptés quand APP_URL_FROM_REQUEST=true, séparés par des virgules.
# Vide = tous acceptés, ce qui permet d'empoisonner les liens générés via
# l'en-tête Host : renseigner la liste en production.
APP_TRUSTED_HOSTS=

# Clé de chiffrement de session (générer : php -r "echo base64_encode(random_bytes(32));")
APP_KEY=

# ── Base de données (MySQL 8.x / MariaDB) ─────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wylde
# Ne jamais utiliser root en production : créer un compte dédié.
DB_USERNAME=wylde
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Boutique ─────────────────────────────────────────────────
# Devise affichée. Les montants sont stockés en DECIMAL(12,0) : sans centimes.
CURRENCY=XOF
CURRENCY_POSITION=after
CURRENCY_DECIMALS=0
# Position d'affichage : before | after
CURRENCY_SEPARATOR="\u{202F}"
# Espace fine insécable entre les milliers

# Seuil d'alerte stock bas (back-office)
STOCK_LOW_THRESHOLD=5

# Paiement Wave Business : lien global affiché au client.
# Wave NE confirme aucun paiement automatiquement : l'admin bascule
# manuellement la commande en « payée ». Laisser vide pour désactiver.
WAVE_PAYMENT_LINK=

# ── Sécurité ─────────────────────────────────────────────────
# Forcer HTTPS (true obligatoire en production)
SESSION_SECURE=true
# Durée de vie de la session en minutes
SESSION_LIFETIME=120
# Nombre max de tentatives de connexion avant blocage
LOGIN_MAX_ATTEMPTS=5
# Durée du blocage en minutes
LOGIN_LOCKOUT_MINUTES=15
# Durée de vie du token CSRF en secondes
CSRF_LIFETIME=7200
# Nombre max d'envois de formulaire par IP et par fenêtre de 60s
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
